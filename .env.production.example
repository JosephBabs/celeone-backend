APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.celeonetv.com
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=celeone
DB_USERNAME=celeone
DB_PASSWORD=CHANGE_ME
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_URL=redis://127.0.0.1:6379
FILESYSTEM_DISK=s3
FIREBASE_API_KEY=CHANGE_ME
SOCKET_PUBLIC_URL=wss://app.celeonetv.com/socket
SOCKET_PORT=4100
SOCKET_PATH=/socket.io
SOCKET_ALLOWED_ORIGINS=https://app.celeonetv.com,https://celeonetv.com
SOCKET_JWT_ISSUER=celeone-api
SOCKET_JWT_AUDIENCE=celeone-socket
SOCKET_JWT_SECRET=GENERATE_AT_LEAST_64_RANDOM_BYTES
SOCKET_INTERNAL_SECRET=GENERATE_A_DIFFERENT_64_BYTE_SECRET
FIREBASE_SYNC_SCRIPT=/var/www/celeone-backend/tools/firebase-targeted-sync.mjs
FIREBASE_SYNC_FILE=/var/www/celeone-backend/storage/app/firebase-targeted.ndjson
FIREBASE_AUTH_FILE=/var/www/celeone-backend/storage/app/firebase-auth.ndjson
GOOGLE_APPLICATION_CREDENTIALS=/var/www/celeone-backend/storage/app/firebase-service-account.json
FIREBASE_SYNC_INTERVAL=60
