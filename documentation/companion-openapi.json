    "/notifications/internal/page-post": {
      "post": {
        "operationId": "post_companion__notifications_internal_page-post",
        "summary": "Internal page-post push delivery",
        "tags": [
          "Internal notifications"
        ],
        "description": "Private queue-worker endpoint. The public API router intentionally returns 404. Available only on the internal notification service, with X-Celeone-Internal authentication.",
