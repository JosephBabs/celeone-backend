<?php

namespace App\Http\Controllers\Auth;

use App\Http\Controllers\Controller;
use App\Models\User;
use Google\Client as GoogleClient;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Schema;
use Illuminate\Support\Str;
use Illuminate\Validation\ValidationException;

class GoogleController extends Controller
{
    /**
     * Exchange a Google ID token for a Laravel Sanctum access token.
     *
     * The mobile app talks to Google only to obtain the ID token. Firebase Auth
     * is intentionally not part of this flow. Google signature/audience/expiry
     * validation is performed server-side using the Google API PHP client.
     */
    public function handleGoogleSignIn(Request $request): JsonResponse
    {
        $data = $request->validate([
            'id_token' => ['nullable', 'string'],
            'idToken' => ['nullable', 'string'], // backwards-compatible client key
            'device_name' => ['nullable', 'string', 'max:120'],
        ]);

        $idToken = trim((string) ($data['id_token'] ?? $data['idToken'] ?? ''));
        if ($idToken === '') {
            throw ValidationException::withMessages([
                'id_token' => ['Google ID token is required.'],
            ]);
        }

        $clientId = trim((string) config('services.google.web_client_id'));
        if ($clientId === '') {
            Log::error('Google authentication is not configured: GOOGLE_WEB_CLIENT_ID is empty.');
            return response()->json([
                'ok' => false,
                'error' => [
                    'code' => 'GOOGLE_SERVER_NOT_CONFIGURED',
                    'message' => 'Google authentication is not configured on the server.',
                ],
            ], 503);
        }

        try {
            $client = new GoogleClient(['client_id' => $clientId]);
            $payload = $client->verifyIdToken($idToken);

            if (! is_array($payload)) {
                return $this->googleFailure('GOOGLE_TOKEN_INVALID', 'Invalid Google ID token.', 401);
            }

            $subject = trim((string) ($payload['sub'] ?? ''));
            $email = strtolower(trim((string) ($payload['email'] ?? '')));
            $audience = (string) ($payload['aud'] ?? '');
            $issuer = (string) ($payload['iss'] ?? '');
            $expiresAt = (int) ($payload['exp'] ?? 0);
            $emailVerified = filter_var($payload['email_verified'] ?? false, FILTER_VALIDATE_BOOLEAN);

            if (
                $subject === '' ||
                $email === '' ||
                ! $emailVerified ||
                ! hash_equals($clientId, $audience) ||
                ! in_array($issuer, ['accounts.google.com', 'https://accounts.google.com'], true) ||
                $expiresAt <= time()
            ) {
                return $this->googleFailure('GOOGLE_TOKEN_REJECTED', 'Google token verification failed.', 401);
            }

            $user = DB::transaction(function () use ($payload, $subject, $email): User {
                $byGoogle = User::query()->where('google_id', $subject)->lockForUpdate()->first();
                $byEmail = User::query()
                    ->where('email', $email)
                    ->orWhereRaw('lower(email) = ?', [$email])
                    ->lockForUpdate()
                    ->first();

                if ($byGoogle && $byEmail && $byGoogle->id !== $byEmail->id) {
                    abort(409, 'This Google account conflicts with an existing Cele One account.');
                }

                $user = $byGoogle ?: $byEmail;
                if ($user && $user->google_id && ! hash_equals((string) $user->google_id, $subject)) {
                    abort(409, 'This email is already linked to another Google account.');
                }

                if (! $user) {
                    $user = User::create([
                        'name' => trim((string) ($payload['name'] ?? '')) ?: Str::before($email, '@'),
                        'email' => $email,
                        // Google-only users do not authenticate with this random password.
                        'password' => Hash::make(Str::random(64)),
                        'google_id' => $subject,
                        'avatar_url' => $payload['picture'] ?? null,
                        'role' => 'user',
                    ]);
                } else {
                    $user->forceFill([
                        'google_id' => $subject,
                        'name' => $user->name ?: (trim((string) ($payload['name'] ?? '')) ?: Str::before($email, '@')),
                        'avatar_url' => $user->avatar_url ?: ($payload['picture'] ?? null),
                    ]);
                }

                if ($user->firebase_disabled) {
                    abort(403, 'This account is disabled.');
                }

                $verifiedUpdates = ['email_verified_at' => $user->email_verified_at ?: now()];
                if (Schema::hasColumn('users', 'password_migrated_at')) {
                    // Google-authenticated users do not need the legacy password migration gate.
                    $verifiedUpdates['password_migrated_at'] = $user->password_migrated_at ?: now();
                }
                $user->forceFill($verifiedUpdates)->save();

                return $user->fresh();
            });

            $deviceName = (string) ($data['device_name'] ?? $request->header('X-Device-ID') ?? 'celeone-mobile-google');
            $accessToken = $user->createToken($deviceName)->plainTextToken;

            return response()->json([
                'ok' => true,
                'data' => [
                    'user' => $user,
                    'password_migrated' => true,
                    'access_token' => $accessToken,
                    'token_type' => 'Bearer',
                ],
                'meta' => [
                    'request_id' => $request->attributes->get('request_id'),
                    'server_time' => now()->toISOString(),
                ],
            ]);
        } catch (\Symfony\Component\HttpKernel\Exception\HttpException $exception) {
            throw $exception;
        } catch (\Throwable $exception) {
            Log::warning('Google authentication failed', [
                'message' => $exception->getMessage(),
                'request_id' => $request->attributes->get('request_id'),
            ]);

            return $this->googleFailure('GOOGLE_AUTH_FAILED', 'Google authentication failed.', 401);
        }
    }

    private function googleFailure(string $code, string $message, int $status): JsonResponse
    {
        return response()->json([
            'ok' => false,
            'error' => [
                'code' => $code,
                'message' => $message,
            ],
            'meta' => [
                'request_id' => request()->attributes->get('request_id'),
                'server_time' => now()->toISOString(),
            ],
        ], $status);
    }
}
