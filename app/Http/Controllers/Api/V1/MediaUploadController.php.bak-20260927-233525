<?php

namespace App\Http\Controllers\Api\V1;

use App\Http\Controllers\Controller;
use App\Http\Controllers\Api\V1\Concerns\ApiResponses;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Str;

class MediaUploadController extends Controller
{
    use ApiResponses;


    public function direct(Request $request)
    {
        $data = $request->validate([
            'file' => 'required|file|max:1228800',
            'storage_folder' => ['nullable', 'string', 'max:160', 'regex:/^[A-Za-z0-9_\/-]+$/'],
            'purpose' => 'nullable|string|max:190',
        ]);

        $file = $data['file'];
        $folder = trim((string) ($data['storage_folder'] ?? ''), '/');
        abort_if(str_contains($folder, '..') || str_contains($folder, '\\'), 422, 'Invalid storage folder.');

        if ($folder === '') {
            $mime = strtolower((string) $file->getMimeType());
            $folder = str_starts_with($mime, 'image/')
                ? 'chat/images'
                : (str_starts_with($mime, 'video/')
                    ? 'chat/videos'
                    : (str_starts_with($mime, 'audio/') ? 'chat/audio' : 'chat/files'));
        }

        // Keep client-selected folders constrained to application-owned namespaces.
        $allowedRoots = ['chat/', 'social/', 'streaming/', 'profiles', 'uploads/'];
        abort_unless(collect($allowedRoots)->contains(fn ($root) => $folder === rtrim($root, '/') || str_starts_with($folder, $root)), 422, 'Unsupported storage folder.');

        $extension = strtolower((string) $file->getClientOriginalExtension());
        if ($extension === '') {
            $extension = match (strtolower((string) $file->getMimeType())) {
                'audio/mp4', 'audio/m4a', 'audio/x-m4a' => 'm4a',
                'audio/mpeg' => 'mp3',
                'video/mp4' => 'mp4',
                'image/jpeg' => 'jpg',
                'image/png' => 'png',
                'image/webp' => 'webp',
                'application/pdf' => 'pdf',
                default => 'bin',
            };
        }

        $name = (string) Str::uuid() . ($extension ? '.' . preg_replace('/[^a-z0-9]/i', '', $extension) : '');
        $path = 'uploads/' . $folder . '/' . $request->user()->id . '/' . date('Y/m') . '/' . $name;
        $diskName = (string) config('chat_media.disk', 'public');
        $disk = Storage::disk($diskName);
        $stream = fopen($file->getRealPath(), 'r');
        abort_unless($stream !== false, 422, 'Unable to read uploaded file.');
        try {
            $stored = $disk->put($path, $stream, [
                'visibility' => 'public',
                'ContentType' => $file->getMimeType() ?: 'application/octet-stream',
            ]);
        } finally {
            if (is_resource($stream)) fclose($stream);
        }
        abort_unless($stored, 500, 'Unable to store uploaded file.');

        $base = rtrim((string) config('chat_media.public_base_url', ''), '/');
        $url = $base !== '' ? $base . '/' . ltrim($path, '/') : $disk->url($path);

        return $this->success([
            'url' => $url,
            'path' => $path,
            'mime' => $file->getMimeType() ?: 'application/octet-stream',
            'size' => (int) $file->getSize(),
            'name' => $file->getClientOriginalName(),
            'provider' => 'vps',
        ], 201);
    }

    public function presign(Request $request)
    {
        // Backward-compatible dual mode: ordinary JSON requests still return a
        // presigned upload URL, while React Native multipart requests containing
        // a file are stored directly on the VPS/public media disk. This avoids
        // requiring a new route during the Firebase -> Laravel migration.
        if ($request->hasFile('file')) {
            return $this->direct($request);
        }

        // Accept both the documented backend contract and the older RN storage
        // compatibility names so older app builds do not fail with HTTP 422.
        $request->merge([
            'file_name' => $request->input('file_name', $request->input('filename')),
            'mime_type' => $request->input('mime_type', $request->input('content_type')),
            'size_bytes' => $request->input('size_bytes', $request->input('size')),
        ]);
        $data = $request->validate([
            'file_name' => 'required|string|max:190',
            'mime_type' => 'required|string|max:120',
            'size_bytes' => 'required|integer|min:1|max:62914560',
        ]);

        $id = (string) Str::ulid();
        $ext = pathinfo($data['file_name'], PATHINFO_EXTENSION);
        $path = 'uploads/' . $request->user()->id . '/' . date('Y/m') . '/' . $id . ($ext ? '.' . $ext : '');
        $disk = Storage::disk(config('filesystems.default'));
        abort_unless(method_exists($disk, 'temporaryUploadUrl'), 501, 'Configured storage does not support signed uploads.');
        $signed = $disk->temporaryUploadUrl($path, now()->addMinutes(15), ['ContentType' => $data['mime_type']]);
        $url = is_array($signed) ? ($signed['url'] ?? null) : $signed;
        $headers = is_array($signed) ? ($signed['headers'] ?? []) : [];

        DB::table('upload_sessions')->insert([
            'public_id' => $id,
            'user_id' => $request->user()->id,
            'status' => 'pending',
            'title' => $data['file_name'],
            'data' => json_encode(['path' => $path, 'mime_type' => $data['mime_type'], 'size_bytes' => $data['size_bytes']]),
            'created_at' => now(),
            'updated_at' => now(),
        ]);

        return $this->success([
            'id' => $id,
            'upload_id' => $id,
            'path' => $path,
            'method' => 'PUT',
            'upload_url' => $url,
            'headers' => $headers,
            'upload' => ['url' => $url, 'headers' => $headers, 'method' => 'PUT'],
            'public_url' => $this->publicUrl($path),
        ]);
    }

    public function complete(Request $request, string $id)
    {
        $row = DB::table('upload_sessions')->where(['public_id' => $id, 'user_id' => $request->user()->id])->first();
        abort_unless($row, 404);
        $asset = json_decode((string) $row->data, true) ?: [];
        $path = (string) ($asset['path'] ?? $request->input('path', ''));
        DB::table('upload_sessions')->where('id', $row->id)->update(['status' => 'complete', 'updated_at' => now()]);
        $url = $path !== '' ? $this->publicUrl($path) : null;
        return $this->success([
            'id' => $id,
            'upload_id' => $id,
            'status' => 'complete',
            'path' => $path,
            'url' => $url,
            'asset' => array_merge($asset, ['url' => $url]),
        ]);
    }

    public function url(Request $request)
    {
        $path = $this->authorizedPath($request, (string) $request->query('path', ''));
        abort_unless($path !== '', 422, 'path is required.');
        return $this->success(['path' => $path, 'url' => $this->publicUrl($path)]);
    }

    public function destroy(Request $request)
    {
        $path = $this->authorizedPath($request, (string) $request->query('path', ''));
        abort_unless($path !== '', 422, 'path is required.');
        Storage::disk(config('filesystems.default'))->delete($path);
        return $this->success(['deleted' => true, 'path' => $path]);
    }

    private function authorizedPath(Request $request, string $path): string
    {
        $path = ltrim(rawurldecode($path), '/');
        abort_if(Str::contains($path, ['..', '\\']), 422, 'Invalid upload path.');
        if (! $request->user()->isAdmin()) {
            abort_unless(Str::startsWith($path, 'uploads/' . $request->user()->id . '/'), 403, 'You do not own this upload.');
        }
        return $path;
    }

    private function publicUrl(string $path): string
    {
        return Storage::disk(config('filesystems.default'))->url($path);
    }
}
