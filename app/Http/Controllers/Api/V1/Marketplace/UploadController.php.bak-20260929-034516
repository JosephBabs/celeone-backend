<?php

namespace App\Http\Controllers\Api\V1\Marketplace;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Str;

class UploadController extends Controller
{
    public function image(Request $request)
    {
        $data = $request->validate([
            'file' => 'required|image|mimes:jpg,jpeg,png,webp|max:10240',
        ]);

        $file = $data['file'];
        $extension = strtolower((string) ($file->getClientOriginalExtension() ?: 'jpg'));
        $path = sprintf(
            'uploads/marketplace/%d/%s/%s.%s',
            $request->user()->id,
            date('Y/m'),
            Str::uuid(),
            preg_replace('/[^a-z0-9]/i', '', $extension)
        );

        $disk = Storage::disk(config('chat_media.disk', 'public'));
        $disk->putFileAs(dirname($path), $file, basename($path), ['visibility' => 'public']);

        $base = trim((string) config('chat_media.public_base_url', ''));
        $url = $base !== ''
            ? rtrim($base, '/') . '/' . ltrim($path, '/')
            : $disk->url($path);

        return response()->json(['data' => [
            'url' => $url,
            'path' => $path,
            'mime' => $file->getMimeType(),
            'size' => $file->getSize(),
        ]], 201);
    }
}
